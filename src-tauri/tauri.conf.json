{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Solana OS",
  "version": "1.0.0-alpha.4",
  "identifier": "os.solana.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Solana OS \u2014 vault.solos",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "decorations": false,
        "transparent": false,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": false,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "version": "1.0.0.4"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCQjUzMTVCOENGQkUzMTcKUldRWDQvdU1XekcxMi9xY2VqN2tpUWIrVkxGaDJqNHdKMksrRTBmZUx5djA5SEI3Z0FBeCtUL04K",
      "endpoints": [
        "https://github.com/ponkssol/Solana-OS/releases/download/updater/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
